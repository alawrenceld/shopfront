# LaunchDarkly server-side SDK key. Optional: without it the app runs with all
# feature flags off.
LD_SDK_KEY=

# Port to listen on. Defaults to 3000.
PORT=3000

# Supplier stock-feed verification at checkout. Nominal per-line latency (the
# feed responds between 0.5x and 1.5x this) and the per-attempt timeout, in ms.
SUPPLIER_VERIFY_DELAY_MS=350
SUPPLIER_VERIFY_TIMEOUT_MS=600
